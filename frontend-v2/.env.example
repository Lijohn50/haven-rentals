# Base URL the browser uses for every REST call (proxied to the backend in dev).
VITE_API_BASE_URL=/api/v1

# Absolute backend origin, used only to build absolute image URLs when the API
# returns a relative media path. Leave empty when the dev proxy is in use.
VITE_API_ORIGIN=

# Public site origin, used for canonical URLs and Open Graph tags.
VITE_SITE_URL=http://localhost:3000

VITE_APP_NAME=Haven

# provider = card form: tokenised by Stripe when a publishable key is set,
#            simulated with Stripe test cards otherwise (default)
# fake     = built-in test-token picker (dev/demo only)
VITE_PAYMENT_MODE=provider

# Stripe publishable key (pk_test_... or pk_live_...). Empty = simulated cards.
VITE_STRIPE_PUBLISHABLE_KEY=

# Leaflet tiles (OpenStreetMap, no API key required).
VITE_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png

VITE_MAP_ATTRIBUTION=&copy; OpenStreetMap contributors

VITE_SUPPORT_EMAIL=support@haven.test