# Vacation Rental Marketplace Environment Configuration Template

# Spring Profile (dev, test, prod)
SPRING_PROFILES_ACTIVE=dev

# Server Configuration
SERVER_PORT=8080

# PostgreSQL 16 System of Record
DB_URL=jdbc:postgresql://localhost:5432/rentals
DB_USER=rentals_user
DB_PASSWORD=rentals_secret

# MongoDB 7 Chat & Messaging
MONGO_URI=mongodb://localhost:27017/rentals

# JJWT Secret Key (Must be >= 32 characters in production)
JWT_SECRET=dev-secret-key-must-be-at-least-32-bytes-long-123456

# SMTP / Mail Settings (MailHog for local dev)
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USER=
MAIL_PASSWORD=

# Frontend and CORS Configuration
APP_FRONTEND_URL=http://localhost:3000
APP_CORS_ORIGINS=http://localhost:3000

# Media and Photo Storage
APP_STORAGE_PATH=./uploads

# Spring AI (Optional)
APP_AI_ENABLED=false
SPRING_AI_API_KEY=
